# Application Port
PORT=3000

# Environment Mode
NODE_ENV=development

# Database Connection URL (Prisma)
# PostgreSQL via Unix domain socket (peer authentication):
# DATABASE_URL="postgresql://<user>@localhost/<dbname>?host=/var/run/postgresql"

# PostgreSQL via TCP:
DATABASE_URL="postgresql://lockmyslot:lockmyslot@localhost:5432/lockmyslot?schema=public"
