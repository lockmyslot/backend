generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───

enum GroupRole {
  ADMIN
  MODERATOR
  MEMBER
  GUEST
}

enum DayScope {
  WEEKDAY
  WEEKEND
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─── Models ───

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String?  @unique
  passwordHash String?  @map("password_hash")
  displayName  String   @map("display_name")
  authToken    String   @unique @map("auth_token") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships      GroupMember[]
  bookings         Booking[]
  createdGroups    Group[]           @relation("GroupCreator")
  maintenanceTasks MaintenanceTask[] @relation("MaintenanceCreator")
  assignedTasks    MaintenanceTask[] @relation("MaintenanceAssignee")
  receivedInvites  GroupInvite[]     @relation("ReceivedInvites")
  sentInvites      GroupInvite[]     @relation("SentInvites")

  @@map("users")
}

model Group {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  inviteCode  String   @unique @map("invite_code")
  color       String?
  icon        String?
  createdById String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy        User              @relation("GroupCreator", fields: [createdById], references: [id])
  members          GroupMember[]
  resources        Resource[]
  bookings         Booking[]
  maintenanceTasks MaintenanceTask[]
  invites          GroupInvite[]

  @@map("groups")
}

model GroupInvite {
  id            String       @id @default(uuid()) @db.Uuid
  groupId       String       @map("group_id") @db.Uuid
  invitedUserId String       @map("invited_user_id") @db.Uuid
  invitedById   String       @map("invited_by_id") @db.Uuid
  status        InviteStatus @default(PENDING)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  group       Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUser User  @relation("ReceivedInvites", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([groupId, invitedUserId])
  @@index([invitedUserId, status])
  @@map("group_invites")
}

model GroupMember {
  id        String    @id @default(uuid()) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      GroupRole @default(MEMBER)
  isPinned  Boolean   @default(false) @map("is_pinned")
  expiresAt DateTime? @map("expires_at")
  joinedAt  DateTime  @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([role, expiresAt])
  @@map("group_members")
}

model Resource {
  id                  String   @id @default(uuid()) @db.Uuid
  groupId             String   @map("group_id") @db.Uuid
  name                String
  description         String?
  icon                String?
  color               String?
  capacity            Int      @default(1)
  slotDurationMinutes Int      @map("slot_duration_minutes") @default(30)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  bookingRules     BookingRule[]
  bookings         Booking[]
  maintenanceTasks MaintenanceTask[]

  @@map("resources")
}

model BookingRule {
  id                    String   @id @default(uuid()) @db.Uuid
  resourceId            String   @map("resource_id") @db.Uuid
  dayScope              DayScope @map("day_scope")
  maxBookingsPerDay     Int?     @map("max_bookings_per_day")
  maxHoursPerDay        Int?     @map("max_hours_per_day")
  cooldownMinutes       Int?     @map("cooldown_minutes")
  minDurationMinutes    Int?     @map("min_duration_minutes")
  maxDurationMinutes    Int?     @map("max_duration_minutes")
  maxAdvanceBookingDays Int?     @map("max_advance_booking_days")
  availableFrom         String?  @map("available_from")   // "HH:mm" format
  availableUntil        String?  @map("available_until")   // "HH:mm" format

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, dayScope])
  @@map("booking_rules")
}

model Booking {
  id         String        @id @default(uuid()) @db.Uuid
  resourceId String        @map("resource_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  groupId    String        @map("group_id") @db.Uuid
  startTime  DateTime      @map("start_time")
  endTime    DateTime      @map("end_time")
  status     BookingStatus @default(CONFIRMED)
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([resourceId, startTime, endTime])
  @@index([userId, groupId])
  @@map("bookings")
}

model MaintenanceTask {
  id             String            @id @default(uuid()) @db.Uuid
  resourceId     String            @map("resource_id") @db.Uuid
  groupId        String            @map("group_id") @db.Uuid
  title          String
  description    String?
  status         MaintenanceStatus @default(SCHEDULED)
  recurrenceType RecurrenceType    @default(NONE) @map("recurrence_type")
  dayOfWeek      Int?              @map("day_of_week") // 0 = Sun, 1 = Mon, ..., 6 = Sat
  startTimeOfDay String?           @map("start_time_of_day") // "HH:mm" UTC
  endTimeOfDay   String?           @map("end_time_of_day")   // "HH:mm" UTC
  startTime      DateTime          @map("start_time")
  endTime        DateTime          @map("end_time")
  createdById    String            @map("created_by") @db.Uuid
  assignedToId   String?           @map("assigned_to") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy  User     @relation("MaintenanceCreator", fields: [createdById], references: [id])
  assignedTo User?    @relation("MaintenanceAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([resourceId, status])
  @@index([groupId, status])
  @@index([startTime, endTime])
  @@index([assignedToId])
  @@map("maintenance_tasks")
}

